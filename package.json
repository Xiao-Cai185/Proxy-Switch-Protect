{
  "name": "proxy-switch-protect",
  "version": "3.5.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "浏览器代理切换与域名落地 IP 守护插件",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build && node tools/pack-zip.mjs",
    "pack": "node tools/pack-zip.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node tools/gen-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
